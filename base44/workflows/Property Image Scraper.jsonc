{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "property_image_scraper",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scrape_images": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scrapePropertyImages"
          },
          "then": "end",
          "x-base44": {
            "title": "Scrape property images",
            "description": "Fetch real listing photos for imageless properties"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */4 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Property Image Scraper",
  "description": "Automatically scrapes real listing photos for active properties that have no images. Runs every 4 hours."
}