{
  "name": "Property Cross-Reference",
  "description": "Daily cross-reference of active properties against the live web to detect sold/off-market listings and update their status",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "property_cross_reference",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "cross_reference": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crossReferenceProperties"
          },
          "then": "end",
          "x-base44": {
            "title": "Cross-reference active properties",
            "description": "Verify listings against live web; expire sold/off-market"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}