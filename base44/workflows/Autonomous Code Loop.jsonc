{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Self-coding loop \u2014 Planner \u2192 Coder \u2192 Validator \u2192 push to GitHub every 5 minutes. Runs the autonomousCodeOrchestrator against the unbuilt-feature blueprint, generates production code, validates it, and auto-merges a PR to the repo with no manual approval.",
  "name": "Autonomous Code Loop",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_code_loop",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_code_cycle": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousCodeOrchestrator",
            "args": {
              "action": "cycle",
              "trigger_source": "workflow"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run self-coding cycle",
            "description": "Planner \u2192 Coder \u2192 Validator \u2192 push to GitHub"
          }
        }
      }
    ]
  }
}