{
  "description": "Two-way sync between the Active Listings Google Sheet and the Property entity every 30 minutes. Sheet is source-of-truth for raw listing facts (address, beds, baths, distress type, source URL); Base44 is source-of-truth for enrichment (score, estimated value, asking price, days on market). Edits in the sheet flow into Base44; enrichment scores flow back to the sheet.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_sheet_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGoogleSheet",
            "args": {
              "trigger_source": "workflow"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Two-way sync Google Sheet \u2194 Property",
            "description": "Upsert sheet rows into Property, write enrichment back to sheet"
          }
        }
      }
    ]
  },
  "name": "Google Sheet Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}