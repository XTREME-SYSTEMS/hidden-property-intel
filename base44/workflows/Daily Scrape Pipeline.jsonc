{
  "description": "Scrapes 5 Florida distressed-property sources per run, every 3 hours, cycling through all 126 sources over ~3 days",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_scrape_pipeline",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_pipeline": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runDailyScrapePipeline"
          },
          "then": "end",
          "x-base44": {
            "title": "Run scrape pipeline",
            "description": "Scrape 5 FL sources + create draft properties"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */3 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Scrape Pipeline"
}