{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "smart_contract_chain_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_contracts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncAllContractStates",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync contract states from Polygon",
            "description": "Reads on-chain state and updates database"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Automatically syncs all deployed smart contract states from the Polygon blockchain back to the database every hour, keeping deal stages and contract statuses in sync with on-chain reality.",
  "name": "Smart Contract Chain Sync"
}