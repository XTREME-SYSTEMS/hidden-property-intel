{
  "description": "Daily autonomous system validation, health logging, and auto-heal (re-run failed sources, reset error sources)",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "system_validation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "validate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "validateSystem"
          },
          "then": "end",
          "x-base44": {
            "title": "Validate & auto-heal system",
            "description": "Inspect all subsystems, log health, re-run failed sources"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "System Validation"
}