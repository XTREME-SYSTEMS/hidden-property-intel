{
  "description": "Evidence-only system health validation and logging; never reclassifies failed jobs or restarts scrapers",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "system_validation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "validate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "validateSystem"
          },
          "then": "end",
          "x-base44": {
            "title": "Evaluate system health without auto-heal",
            "description": "Inspect subsystems, report stale acquisition, and log health only"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "System Validation"
}