{
  "description": "Daily autonomous investor-lead harvesting + investor & seller email outreach",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_outreach",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_outreach": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runDailyOutreach"
          },
          "then": "end",
          "x-base44": {
            "title": "Run daily outreach",
            "description": "Scrape investor leads for active markets + email investors and sellers"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Outreach"
}