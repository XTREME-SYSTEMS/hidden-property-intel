{
  "name": "Draft Property Processor",
  "description": "Nightly batch: fetches real images for draft properties, promotes to active, and scores them",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "draft_property_processor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_drafts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processDraftProperties"
          },
          "then": "end",
          "x-base44": {
            "title": "Process draft properties",
            "description": "Fetch images, promote to active, score"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}