{
  "name": "AiGatewayValidationReceipt",
  "type": "object",
  "properties": {
    "receipt_id": { "type": "string" },
    "tested_at": { "type": "string", "format": "date-time" },
    "source_sha": { "type": "string" },
    "environment": { "type": "string", "enum": ["sandbox", "test"] },
    "producer": { "type": "string", "enum": ["ai-gateway-no-spend-validator"] },
    "artifact_ref": { "type": "string" },
    "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "schema_valid": { "type": "boolean" },
    "request_id": { "type": "string" },
    "spend_usd": { "type": "number", "minimum": 0 },
    "live_side_effects": { "type": "boolean" },
    "error_count": { "type": "integer", "minimum": 0 }
  },
  "required": [
    "receipt_id",
    "tested_at",
    "source_sha",
    "environment",
    "producer",
    "artifact_ref",
    "http_status",
    "schema_valid",
    "request_id",
    "spend_usd",
    "live_side_effects",
    "error_count"
  ],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
