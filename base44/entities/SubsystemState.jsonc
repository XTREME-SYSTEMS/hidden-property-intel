{
  "name": "SubsystemState",
  "type": "object",
  "properties": {
    "subsystem": {
      "type": "string",
      "description": "e.g. frontend, backend, rls, ingestion, data_quality, payments, seo, pwa, ai, observability"
    },
    "current_mode": {
      "type": "string",
      "enum": [
        "completion",
        "preservation",
        "incident"
      ],
      "default": "completion"
    },
    "health": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "critical"
      ],
      "default": "degraded"
    },
    "last_heartbeat": {
      "type": "string",
      "format": "date-time"
    },
    "last_repair": {
      "type": "string",
      "format": "date-time"
    },
    "open_findings": {
      "type": "number",
      "default": 0
    },
    "failed_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drift_detected": {
      "type": "boolean",
      "default": false
    },
    "consecutive_clean_heartbeats": {
      "type": "number",
      "default": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "subsystem"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}