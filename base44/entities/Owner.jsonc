{
  "name": "Owner",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "current",
        "previous",
        "potential_heir"
      ],
      "default": "current"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "individual",
        "llc",
        "trust",
        "corporation",
        "partnership",
        "government",
        "unknown"
      ],
      "default": "individual",
      "description": "Legal structure of the owner"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_address": {
      "type": "string"
    },
    "relationship_to_property": {
      "type": "string"
    },
    "acquired_date": {
      "type": "string",
      "format": "date"
    },
    "ownership_percentage": {
      "type": "number"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "deceased": {
      "type": "boolean",
      "default": false,
      "description": "True if owner is confirmed or likely deceased"
    },
    "confidence_score": {
      "type": "number",
      "description": "0-100 confidence that this owner identity + contact info is correct"
    },
    "aka": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Aliases / alternate names (maiden, DBA, middle-name variants)"
    },
    "identification_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "found",
              "not_found",
              "partial",
              "error"
            ]
          },
          "result": {
            "type": "string"
          }
        }
      },
      "description": "Every identification method attempted and its outcome"
    },
    "source": {
      "type": "string"
    },
    "outreach_status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "responded",
        "opted_out"
      ],
      "default": "new"
    },
    "contacted_at": {
      "type": "string",
      "format": "date-time"
    },
    "follow_up_enabled": {
      "type": "boolean",
      "default": false
    },
    "follow_up_frequency_days": {
      "type": "number",
      "default": 7
    },
    "next_follow_up_date": {
      "type": "string",
      "format": "date-time"
    },
    "automation_enabled": {
      "type": "boolean",
      "default": false
    },
    "is_reachable": {
      "type": "boolean",
      "default": true
    },
    "next_of_kin": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "contact_phone": {
            "type": "string"
          },
          "contact_email": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "last_outreach_subject": {
      "type": "string"
    },
    "last_outreach_body": {
      "type": "string"
    },
    "last_identified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the owner identification engine last ran"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}