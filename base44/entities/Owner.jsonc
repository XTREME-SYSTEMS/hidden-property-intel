{
  "name": "Owner",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "current",
        "previous",
        "potential_heir"
      ],
      "default": "current"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_address": {
      "type": "string"
    },
    "relationship_to_property": {
      "type": "string"
    },
    "acquired_date": {
      "type": "string",
      "format": "date"
    },
    "ownership_percentage": {
      "type": "number"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string"
    },
    "outreach_status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "responded",
        "opted_out"
      ],
      "default": "new"
    },
    "contacted_at": {
      "type": "string",
      "format": "date-time"
    },
    "follow_up_enabled": {
      "type": "boolean",
      "default": false
    },
    "follow_up_frequency_days": {
      "type": "number",
      "default": 7
    },
    "next_follow_up_date": {
      "type": "string",
      "format": "date-time"
    },
    "automation_enabled": {
      "type": "boolean",
      "default": false
    },
    "is_reachable": {
      "type": "boolean",
      "default": true
    },
    "next_of_kin": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "contact_phone": {
            "type": "string"
          },
          "contact_email": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "last_outreach_subject": {
      "type": "string"
    },
    "last_outreach_body": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}