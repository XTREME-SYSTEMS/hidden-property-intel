{
  "name": "Owner",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "current",
        "previous",
        "potential_heir"
      ],
      "default": "current"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_address": {
      "type": "string"
    },
    "relationship_to_property": {
      "type": "string"
    },
    "acquired_date": {
      "type": "string",
      "format": "date"
    },
    "ownership_percentage": {
      "type": "number"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string"
    },
    "outreach_status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "responded",
        "opted_out"
      ],
      "default": "new"
    },
    "contacted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "property_id",
    "name"
  ]
}