{
  "name": "PhoneNumber",
  "type": "object",
  "properties": {
    "number": {
      "type": "string",
      "description": "E.164 normalized phone number (e.g. +17728123930)"
    },
    "country_code": {
      "type": "string",
      "default": "US"
    },
    "country": {
      "type": "string"
    },
    "line_type": {
      "type": "string",
      "enum": [
        "mobile",
        "landline",
        "voip",
        "unknown"
      ],
      "default": "unknown"
    },
    "carrier": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sandbox",
        "credentials_required",
        "active",
        "provisioned",
        "failed",
        "opted_out"
      ],
      "default": "sandbox"
    },
    "tenant_id": {
      "type": "string",
      "description": "Owner of this number record"
    },
    "source": {
      "type": "string",
      "enum": [
        "csv_import",
        "lead_form",
        "manual",
        "api",
        "scraped"
      ],
      "default": "api"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_lookup_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "description": "Extra carrier/lookup metadata"
    }
  },
  "required": [
    "number",
    "tenant_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}