{
  "name": "DataSource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "county_assessor",
        "tax_records",
        "probate_court",
        "foreclosure",
        "auction",
        "obituary",
        "mls",
        "code_violation",
        "divorce",
        "bankruptcy",
        "short_sale",
        "bank_owned",
        "hoa_foreclosure",
        "mobile_home",
        "commercial",
        "land",
        "legal_notice",
        "lis_pendens",
        "tax_lien",
        "aggregator",
        "waterfront",
        "multi_family",
        "vacant_land",
        "agricultural",
        "mixed_use",
        "condo",
        "rental",
        "eviction",
        "environmental",
        "permit"
      ]
    },
    "url": {
      "type": "string"
    },
    "scrape_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "daily"
    },
    "scrape_config": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "error",
        "paused"
      ],
      "default": "active"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "properties_yielded": {
      "type": "number",
      "default": 0
    },
    "health_score": {
      "type": "number"
    },
    "consecutive_failures": {
      "type": "number",
      "default": 0
    },
    "paused_until": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "county": {
      "type": "string",
      "description": "Florida county name (e.g., Miami-Dade, Broward)"
    },
    "distress_type": {
      "type": "string",
      "enum": [
        "pre-foreclosure",
        "foreclosure",
        "probate_inherited",
        "tax_delinquent",
        "code_violation",
        "divorce",
        "bankruptcy",
        "auction",
        "short_sale",
        "bank_owned",
        "hoa_foreclosure",
        "waterfront",
        "eviction",
        "environmental",
        "permit",
        "mixed_distress"
      ]
    },
    "property_type": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "land",
        "multi-family",
        "mixed-use",
        "mobile",
        "condo",
        "vacant_land",
        "agricultural",
        "waterfront",
        "industrial",
        "retail",
        "office",
        "all"
      ],
      "default": "all"
    },
    "acquisition_method": {
      "type": "string",
      "enum": [
        "cloudbrowser",
        "ai",
        "browser",
        "api",
        "manual"
      ],
      "default": "cloudbrowser"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "high"
    },
    "anti_bot_required": {
      "type": "boolean",
      "default": false,
      "description": "True if source has WAF/bot detection requiring stealth mode"
    },
    "proxy_required": {
      "type": "boolean",
      "default": false,
      "description": "True if source blocks datacenter IPs and needs residential proxy"
    },
    "captcha_required": {
      "type": "boolean",
      "default": false,
      "description": "True if source presents CAPTCHAs"
    },
    "notes": {
      "type": "string",
      "description": "Source-specific scraping notes, selectors, or configuration hints"
    }
  },
  "required": [
    "name",
    "type",
    "url"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}