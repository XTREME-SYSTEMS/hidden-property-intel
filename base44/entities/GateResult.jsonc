{
  "name": "GateResult",
  "type": "object",
  "properties": {
    "gate_id": {
      "type": "string",
      "description": "Matches releaseConstitution gate_id"
    },
    "category": {
      "type": "string"
    },
    "mandatory": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Empty = cannot be PASS"
    },
    "detail": {
      "type": "string"
    },
    "last_passed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_sha": {
      "type": "string"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "gate_id",
    "category",
    "mandatory",
    "status",
    "evaluated_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}