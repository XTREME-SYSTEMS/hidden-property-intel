{
  "name": "HeartbeatReceipt",
  "type": "object",
  "properties": {
    "heartbeat_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "completion",
        "preservation",
        "incident"
      ],
      "default": "completion"
    },
    "lease_acquired": {
      "type": "boolean"
    },
    "lease_owner": {
      "type": "string"
    },
    "jobs_due": {
      "type": "number",
      "default": 0
    },
    "jobs_dispatched": {
      "type": "number",
      "default": 0
    },
    "receipts_collected": {
      "type": "number",
      "default": 0
    },
    "gate_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_findings": {
      "type": "number",
      "default": 0
    },
    "release_ready": {
      "type": "boolean",
      "default": false
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "next_due_smoke": {
      "type": "string",
      "format": "date-time"
    },
    "next_due_optimize": {
      "type": "string",
      "format": "date-time"
    },
    "next_due_benchmark": {
      "type": "string",
      "format": "date-time"
    },
    "source_sha": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "heartbeat_id",
    "timestamp",
    "mode"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}