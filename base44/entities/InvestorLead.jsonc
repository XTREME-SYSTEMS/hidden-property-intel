{
  "name": "InvestorLead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "target_markets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "investment_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "region": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "outreach_status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "responded",
        "opted_out"
      ],
      "default": "new"
    },
    "last_contacted": {
      "type": "string",
      "format": "date-time"
    },
    "contact_count": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "follow_up_enabled": {
      "type": "boolean",
      "default": false
    },
    "follow_up_frequency_days": {
      "type": "number",
      "default": 7
    },
    "next_follow_up_date": {
      "type": "string",
      "format": "date-time"
    },
    "automation_enabled": {
      "type": "boolean",
      "default": false
    },
    "last_outreach_subject": {
      "type": "string"
    },
    "last_outreach_body": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}