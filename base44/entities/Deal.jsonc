{
  "name": "Deal",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "lead",
        "underwriting",
        "offer",
        "contract",
        "closing",
        "rehab",
        "exit"
      ],
      "default": "lead"
    },
    "exit_strategy": {
      "type": "string",
      "enum": [
        "flip",
        "brrrr",
        "buy_hold",
        "wholesale"
      ]
    },
    "acquisition_price": {
      "type": "number"
    },
    "rehab_budget": {
      "type": "number"
    },
    "arv": {
      "type": "number"
    },
    "holding_costs": {
      "type": "number"
    },
    "projected_profit": {
      "type": "number"
    },
    "actual_profit": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "won",
        "lost",
        "archived"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    },
    "target_close_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_id",
    "property_id",
    "stage"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}