{
  "name": "AlertPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email_alerts": {
      "type": "boolean",
      "default": true
    },
    "push_alerts": {
      "type": "boolean",
      "default": true
    },
    "sms_alerts": {
      "type": "boolean",
      "default": false
    },
    "phone": {
      "type": "string"
    },
    "min_score": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}