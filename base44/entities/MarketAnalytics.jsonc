{
  "name": "MarketAnalytics",
  "type": "object",
  "properties": {
    "region": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "avg_price": {
      "type": "number"
    },
    "avg_price_per_sqft": {
      "type": "number"
    },
    "avg_days_on_market": {
      "type": "number"
    },
    "distress_property_count": {
      "type": "number"
    },
    "price_trend": {
      "type": "string",
      "enum": [
        "rising",
        "falling",
        "stable"
      ]
    },
    "trend_percentage": {
      "type": "number"
    },
    "median_roi": {
      "type": "number"
    },
    "top_distress_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "region"
  ]
}