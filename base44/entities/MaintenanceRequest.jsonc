{
  "name": "MaintenanceRequest",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "property_manager_id": {
      "type": "string"
    },
    "tenant_name": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "plumbing",
        "electrical",
        "hvac",
        "appliance",
        "structural",
        "landscaping",
        "pest_control",
        "roofing",
        "other"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "emergency"
      ],
      "default": "medium"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "assigned",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "assigned_vendor": {
      "type": "string"
    },
    "estimated_cost": {
      "type": "number"
    },
    "actual_cost": {
      "type": "number"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_priority_score": {
      "type": "number"
    },
    "ai_recommendation": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "request_type",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.property_manager_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.property_manager_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.property_manager_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}