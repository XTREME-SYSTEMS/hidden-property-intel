{
  "name": "SwarmCycle",
  "type": "object",
  "properties": {
    "cycle_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "complete",
        "failed"
      ],
      "default": "running"
    },
    "phase": {
      "type": "string",
      "description": "audit | deliberate | execute | log"
    },
    "trigger_source": {
      "type": "string",
      "enum": [
        "cron",
        "manual",
        "workflow"
      ],
      "default": "cron"
    },
    "national_coverage": {
      "type": "object",
      "description": "Snapshot of national coverage at cycle start",
      "properties": {
        "states_covered": {
          "type": "number"
        },
        "counties_covered": {
          "type": "number"
        },
        "total_properties": {
          "type": "number"
        },
        "target_markets": {
          "type": "number"
        },
        "uncovered_markets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "description": "The swarm's chosen action this cycle",
      "properties": {
        "action": {
          "type": "string"
        },
        "specialist_agent": {
          "type": "string"
        },
        "function_to_call": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "execution_result": {
      "type": "object",
      "description": "Result of the executed function"
    },
    "actions_taken": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "cycle_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}