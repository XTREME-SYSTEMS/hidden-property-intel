{
  "name": "ValidationTask",
  "type": "object",
  "properties": {
    "validation_task_id": {
      "type": "string",
      "description": "Unique validation task identifier"
    },
    "gate_id": {
      "type": "string",
      "description": "Constitution gate_id this task covers"
    },
    "validator_id": {
      "type": "string",
      "description": "Validator that will evaluate this gate (or 'unimplemented' if none yet)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "p0",
        "p1",
        "p2"
      ],
      "default": "p1"
    },
    "status": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "VALIDATOR_REQUIRED",
        "VALIDATOR_READY",
        "VALIDATING",
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "default": "VALIDATOR_REQUIRED"
    },
    "source_sha": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "description": "Why this gate is unresolved (e.g. 'CI check not configured', 'no validator implemented yet')"
    },
    "attempt_count": {
      "type": "number",
      "default": 0
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker": {
      "type": "string",
      "description": "What blocks this gate from being resolved"
    },
    "wave": {
      "type": "string",
      "description": "Which validator wave covers this gate (e.g. wave1, wave2, unassigned)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "validation_task_id",
    "gate_id",
    "validator_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}