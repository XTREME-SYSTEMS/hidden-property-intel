{
  "name": "Finding",
  "type": "object",
  "properties": {
    "finding_id": {
      "type": "string",
      "description": "Unique finding identifier"
    },
    "subsystem": {
      "type": "string",
      "description": "e.g. frontend, backend, rls, ingestion, data_quality, payments, seo"
    },
    "category": {
      "type": "string",
      "description": "Gate category or defect class"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "p0",
        "p1",
        "p2"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "reproduction_steps": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "discovered",
        "diagnosed",
        "repair_planned",
        "repair_implemented",
        "tested",
        "independently_validated",
        "regression_passed",
        "closed",
        "failed",
        "blocked",
        "retry_recovered"
      ],
      "default": "discovered"
    },
    "assigned_specialist": {
      "type": "string"
    },
    "repair_task_id": {
      "type": "string"
    },
    "validation_receipt_id": {
      "type": "string"
    },
    "regression_of": {
      "type": "string",
      "description": "finding_id this is a regression of, if applicable"
    },
    "source_sha": {
      "type": "string"
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "finding_id",
    "subsystem",
    "severity",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}