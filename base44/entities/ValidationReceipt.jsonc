{
  "name": "ValidationReceipt",
  "type": "object",
  "properties": {
    "validation_id": {
      "type": "string"
    },
    "repair_id": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "validator_agent": {
      "type": "string",
      "description": "Independent Release Validator (s14) \u2014 never the repair agent"
    },
    "independent": {
      "type": "boolean",
      "default": true,
      "description": "True only if validator differs from repair agent"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "test_results": {
      "type": "object"
    },
    "regression_results": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "No evidence = no PASS"
    },
    "source_sha": {
      "type": "string"
    },
    "reasoning": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "validation_id",
    "repair_id",
    "finding_id",
    "validator_agent",
    "independent",
    "verdict",
    "source_sha",
    "timestamp"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}