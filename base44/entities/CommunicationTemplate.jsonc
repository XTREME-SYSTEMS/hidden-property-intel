{
  "name": "CommunicationTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "industry": {
      "type": "string",
      "default": "real_estate"
    },
    "channel": {
      "type": "string",
      "enum": [
        "voice",
        "sms",
        "mms",
        "whatsapp",
        "email",
        "facebook",
        "instagram",
        "linkedin",
        "twitter",
        "tiktok",
        "discord",
        "rcs",
        "universal"
      ],
      "default": "email"
    },
    "situation": {
      "type": "string",
      "enum": [
        "sales",
        "marketing",
        "follow_up",
        "outreach",
        "response",
        "objection_handling",
        "qualification",
        "closing",
        "appointment",
        "nurture",
        "re_engagement"
      ],
      "default": "outreach"
    },
    "tone": {
      "type": "string",
      "enum": [
        "professional",
        "casual",
        "urgent",
        "empathetic",
        "authoritative",
        "friendly",
        "persuasive",
        "consultative",
        "energetic",
        "calm"
      ],
      "default": "professional"
    },
    "target_audience": {
      "type": "string",
      "description": "investor, owner, heir, agent"
    },
    "template_body": {
      "type": "string"
    },
    "subject_line": {
      "type": "string"
    },
    "psychology_notes": {
      "type": "string",
      "description": "Why this template works \u2014 psychological triggers"
    },
    "high_response_words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "words_to_avoid": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "effectiveness_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 predicted effectiveness"
    },
    "compliance_notes": {
      "type": "string"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "channel"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}