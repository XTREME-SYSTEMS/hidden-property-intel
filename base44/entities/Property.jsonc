{
  "name": "Property",
  "type": "object",
  "properties": {
    "address": {
      "type": "string"
    },
    "normalized_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "land",
        "multi-family",
        "mixed-use"
      ],
      "default": "residential"
    },
    "distress_type": {
      "type": "string",
      "enum": [
        "pre-foreclosure",
        "foreclosure",
        "probate_inherited",
        "tax_delinquent",
        "code_violation",
        "divorce",
        "bankruptcy",
        "auction",
        "short_sale",
        "bank_owned"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "under_contract",
        "closed",
        "expired",
        "draft"
      ],
      "default": "active"
    },
    "estimated_value": {
      "type": "number"
    },
    "proposed_asking_price": {
      "type": "number"
    },
    "property_score": {
      "type": "number"
    },
    "square_footage": {
      "type": "number"
    },
    "bedrooms": {
      "type": "number"
    },
    "bathrooms": {
      "type": "number"
    },
    "year_built": {
      "type": "number"
    },
    "lot_size": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "scraped",
        "user_submitted",
        "mls_import"
      ],
      "default": "scraped"
    },
    "source_url": {
      "type": "string"
    },
    "scraped_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "image_fetch_attempts": {
      "type": "number",
      "default": 0
    },
    "days_on_market": {
      "type": "number"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "rental_estimate": {
      "type": "number",
      "description": "Estimated monthly rent (USD)"
    },
    "neighborhood_rating": {
      "type": "number",
      "description": "Neighborhood quality 1-10"
    },
    "school_rating": {
      "type": "number",
      "description": "Nearby public school rating 1-10"
    },
    "crime_level": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "unknown"
      ],
      "default": "unknown"
    },
    "flood_zone": {
      "type": "string",
      "description": "FEMA flood zone designation (e.g. X, AE, VE)"
    },
    "zoning": {
      "type": "string",
      "description": "Zoning designation (e.g. RS-1, RM-2, commercial)"
    },
    "tax_assessed_value": {
      "type": "number",
      "description": "Current tax assessed value (USD)"
    },
    "equity_estimate": {
      "type": "number",
      "description": "Estimated equity: market value minus liens (USD)"
    },
    "occupancy_status": {
      "type": "string",
      "enum": [
        "vacant",
        "occupied",
        "unknown"
      ],
      "default": "unknown"
    },
    "investor_summary": {
      "type": "string",
      "description": "AI-generated investor analysis narrative"
    },
    "enriched_at": {
      "type": "string",
      "format": "date-time",
      "description": "When data enrichment was last run"
    }
  },
  "required": [
    "address",
    "city",
    "state",
    "zip_code"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}