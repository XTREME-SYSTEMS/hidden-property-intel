{
  "name": "hidden-property-intel-scraper",
  "version": "1.0.0",
  "main": "dist/scraper-cron.js",
  "scripts": {
    "build": "tsc scraper-cron.ts --outDir dist --module commonjs --target es2020 --lib es2020 --skipLibCheck --esModuleInterop --resolveJsonModule",
